# Copiá este archivo a ".env" y completá los valores para tu máquina.
# El .env real NO se sube a git (contiene datos sensibles).

# Base de datos MySQL (XAMPP por defecto)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=chaskiDB

# Clave secreta para firmar los tokens JWT. Usá una frase larga y propia,
# no la dejes igual en producción.
JWT_SECRET_KEY=cambia-esta-clave-por-una-propia

# Configuración del servidor Flask
FLASK_DEBUG=True
FLASK_PORT=5000
